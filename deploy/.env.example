# Copy to deploy/.env and fill in. Never commit the real .env.
#   cp deploy/.env.example deploy/.env

# Strong password for the internal Postgres (not exposed publicly).
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Ingest key the Flutter app sends (X-QARO-App-Key). Generated this session:
APP_KEY=qaro_e59b4dd89e5b00c63f797e01eb2ad0cd13b68ef5db1834b5

# Guards the read-only query endpoints (admin portal uses it). Generated this session:
INTERNAL_QUERY_KEY=iq_e631832fd441e28452b7a0e24e9c461c9bef48c6795dd339

# --- Admin dashboard (admin.qaro.ae) ---
# Shared password to sign in to the dashboard.
ADMIN_PASSWORD=change-me-admin-password
# Opaque browser-cookie token (NOT the password). Generate: openssl rand -hex 24
ADMIN_SESSION_TOKEN=change-me-session-token
