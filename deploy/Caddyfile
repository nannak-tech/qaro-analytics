# Auto-HTTPS reverse proxy for the ingest API.
# Caddy fetches + renews a Let's Encrypt cert automatically, as soon as
# analytics.qaro.ae resolves to this box and ports 80/443 are open.
# Using a different domain? Change it here.

analytics.qaro.ae {
    reverse_proxy ingest-api:4100
}

# Admin dashboard (customer-journey + ads). Password-gated in the app itself.
admin.qaro.ae {
    reverse_proxy admin:3100
}
