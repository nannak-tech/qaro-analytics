# ingest-api configuration
PORT=4100

# ClickHouse (event store)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=qaro_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Postgres (control plane: app keys, partners, campaigns)
POSTGRES_URL=postgres://qaro:qaro@localhost:5432/qaro_analytics

# Comma-separated plaintext ingest keys accepted as a fallback when Postgres
# app_keys is empty (dev convenience). In prod, keys live in app_keys (hashed).
DEV_APP_KEYS=qaro-customer:dev-customer-key

# Max events per POST /v1/events batch
MAX_BATCH=500
