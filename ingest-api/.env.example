# ingest-api configuration
PORT=4100

# Postgres — the single store (events + control plane).
POSTGRES_URL=postgres://qaro:qaro@localhost:5432/qaro_analytics
# Set PGSSL=disable for a local non-TLS Postgres (docker-compose). Managed PG
# (RDS) uses TLS by default.
PGSSL=disable
PG_POOL_MAX=10

# Comma-separated plaintext ingest keys: "app-name:key,app-name:key".
# In prod these live hashed in the app_keys table; this is the simple path.
DEV_APP_KEYS=qaro-customer:dev-customer-key

# Guards the read-only query endpoints (used by the admin portal).
INTERNAL_QUERY_KEY=

# Max events per POST /v1/events batch
MAX_BATCH=500
