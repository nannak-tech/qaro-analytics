# Where the admin reaches the ingest query API (server-side only).
# In docker-compose this is the service name; locally use http://localhost:4100
INGEST_URL=http://ingest-api:4100

# Must match ingest-api's INTERNAL_QUERY_KEY so the query endpoints accept us.
INTERNAL_QUERY_KEY=change-me-internal-query-key

# Shared-password gate for the dashboard.
ADMIN_PASSWORD=change-me-admin-password
# Opaque session token stored in the browser cookie (not the password).
# Generate with: openssl rand -hex 24
ADMIN_SESSION_TOKEN=change-me-session-token
