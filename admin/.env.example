# Where the admin reaches the ingest query + control API (server-side only).
# In docker-compose this is the service name; locally use http://localhost:4100
INGEST_URL=http://ingest-api:4100

# Must match ingest-api's INTERNAL_QUERY_KEY so the query/control endpoints accept us.
INTERNAL_QUERY_KEY=change-me-internal-query-key

# Secret used to sign session JWTs (the login cookie). Generate: openssl rand -hex 32
AUTH_SECRET=change-me-auth-secret
